# Template — copy to .env.<environment> (e.g. .env.sandbox) and fill in real values.
# The real .env.* files are gitignored; THIS file is committed as documentation.
#
# Real secrets do NOT belong here — use GitHub Actions secrets (CI) or
# AWS SSM / Secrets Manager (runtime). See ENVIRONMENT.md.
#
# Run `npm run env:sync` after adding a key here — it appends the key, with this
# comment, to every .env.<environment> file that is missing it.
#
# DEPLOY_ENV is required, one of: prod | staging | dev | sandbox | test
# `test` needs NO .env.test file — infra/test/setup.ts supplies its values.
DEPLOY_ENV=

# Primary site domain (apex) for this environment. The CloudFront distribution
# serves both this and its www. subdomain. e.g. sandbox.mattignaczak.xyz
SITE_DOMAIN_NAME=

# ACM certificate ARN covering SITE_DOMAIN_NAME and www.<SITE_DOMAIN_NAME>.
# MUST be issued in us-east-1 — CloudFront only reads certs from that region.
ACM_CERT_ARN=

###################
#Audio bookshelf env vars
###################
# Audio bookshelf domain name 
ABS_DOMAIN_NAME=
# Audio bookshelf acme email 
ABS_ACME_EMAIL=
# Audio bookshelf image digest 
ABS_IMAGE_DIGEST=
# Audio bookshelf data volume (your books) created by a script
# infra/scripts/abs-bootstrap-volume.sh generates it 
ABS_DATA_VOLUME_ID=
# Audio bookshelf data volume az -> everything needs to be in one az
ABS_AZ=

# (OPTIONAL) Audio bookshelf instance type in case you need to configure it
# ABS_INSTANCE_TYPE=

